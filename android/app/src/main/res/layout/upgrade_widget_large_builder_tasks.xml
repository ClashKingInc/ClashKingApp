<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/upgrade_large_builder_task_one"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/upgrade_large_builder_task_one_image"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/upgrade_widget_task_description"
            android:scaleType="centerInside"
            android:src="@drawable/ic_upgrade_task_placeholder" />

        <TextView
            android:id="@+id/upgrade_large_builder_task_one_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Clock Tower&#10;Lv 7 → 8 · 2d"
            android:textColor="@color/widget_text"
            android:textSize="9.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upgrade_large_builder_task_two"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/upgrade_large_builder_task_two_image"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/upgrade_widget_task_description"
            android:scaleType="centerInside"
            android:src="@drawable/ic_upgrade_task_placeholder" />

        <TextView
            android:id="@+id/upgrade_large_builder_task_two_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Air Bombs&#10;Lv 9 → 10 · 4h"
            android:textColor="@color/widget_text"
            android:textSize="9.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/upgrade_large_builder_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9.5sp"
        android:visibility="gone" />
</merge>
