<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/legends_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- The launcher slot may be tall; only this bounded card gets a background. -->
    <FrameLayout android:id="@+id/legends_card" android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="center" android:background="@drawable/legends_widget_background">
    <LinearLayout android:id="@+id/legends_content" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/legends_town_hall" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/legends_widget_town_hall_description" android:scaleType="centerInside" android:src="@drawable/ic_upgrade_hall_placeholder" />
            <TextView android:id="@+id/legends_player_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/legends_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout>
        <!-- One centered focal row, like the small iOS card. Rank is medium-only. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="10dp" android:gravity="center" android:baselineAligned="false" android:orientation="horizontal">
            <ImageView android:id="@+id/legends_trophy_icon" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:scaleType="centerInside" />
            <TextView android:id="@+id/legends_net_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:includeFontPadding="false" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/legends_rank_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="10sp" />
            <TextView android:id="@+id/legends_rank_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/legends_attack_icon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/legends_widget_attacks" android:scaleType="centerInside"/>
                    <TextView android:id="@+id/legends_attack_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/legends_attack_trophies" android:layout_width="wrap_content" android:layout_height="16dp" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/legends_defense_icon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/legends_widget_defenses" android:scaleType="centerInside"/>
                    <TextView android:id="@+id/legends_defense_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/legends_defense_trophies" android:layout_width="wrap_content" android:layout_height="16dp" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/legends_recent_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="3dp" android:layout_marginBottom="4dp" android:layout_weight="1" android:background="@drawable/legends_widget_surface" android:gravity="center_vertical" android:orientation="vertical" android:paddingHorizontal="7dp" android:paddingVertical="3dp">
            <TextView android:id="@+id/legends_recent_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="10sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/legends_recent_opponent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="11sp" android:textStyle="bold" />
                <ImageView android:id="@+id/legends_recent_kind_icon" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginStart="4dp" android:contentDescription="@null" android:scaleType="centerInside" />
                <TextView android:id="@+id/legends_recent_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/legends_recent_star_one" android:layout_width="10dp" android:layout_height="10dp" android:contentDescription="@null" android:scaleType="centerInside" />
                <ImageView android:id="@+id/legends_recent_star_two" android:layout_width="10dp" android:layout_height="10dp" android:contentDescription="@null" android:scaleType="centerInside" />
                <ImageView android:id="@+id/legends_recent_star_three" android:layout_width="10dp" android:layout_height="10dp" android:contentDescription="@null" android:scaleType="centerInside" />
                <TextView android:id="@+id/legends_recent_percentage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/legends_recent_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/legends_no_activity" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center" android:padding="6dp" android:maxLines="3" android:textColor="@color/widget_text" android:textSize="10sp" android:visibility="gone" />

        <LinearLayout android:id="@+id/legends_clan_group" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <ImageView android:id="@+id/legends_clan_badge" android:layout_width="0dp" android:layout_height="0dp" android:contentDescription="@string/legends_widget_clan_badge_description" />
            <TextView android:id="@+id/legends_clan_name" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
        <TextView android:id="@+id/legends_stale_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:background="@drawable/legends_widget_stale_chip" android:textColor="@color/widget_text" android:textSize="10sp" android:maxLines="2" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/legends_empty_state" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/legends_widget_surface" android:gravity="center" android:padding="16dp" android:textColor="@color/widget_text" android:textSize="12sp" android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
