# production, staging, development, or local
EXPO_PUBLIC_CK_API_ENV=staging

# Optional override for the built-in Sentry DSN.
# Reporting is errors-only; tracing, profiling, replay, logs, and sessions stay disabled.
EXPO_PUBLIC_CK_SENTRY_DSN=

# Optional endpoint overrides. Omit these to use the canonical URLs for CK_API_ENV.
EXPO_PUBLIC_CK_API_BASE_URL=https://dev-api.clashk.ing
EXPO_PUBLIC_CK_API_V2_BASE_URL=https://dev-api.clashk.ing/v2
EXPO_PUBLIC_CK_PROXY_BASE_URL=https://dev-api.clashk.ing/proxy/v1
EXPO_PUBLIC_CK_PUSH_API_V2_BASE_URL=https://dev-api.clashk.ing/v2

# Web OAuth callback. Native builds use the clashking:// scheme.
EXPO_PUBLIC_CK_WEB_DISCORD_REDIRECT_URI=https://staging-app.clashk.ing/auth/discord_callback.html
EXPO_PUBLIC_CK_DISCORD_SIGN_IN_ENABLED=true
# Optional Metro-only preview of unpublished local game data. Leave unset for normal use.
# Production exports ignore EXPO_PUBLIC_LOCAL_GAME_ASSETS_URL even when configured.
# EXPO_PUBLIC_LOCAL_GAME_ASSETS_URL=https://local-app.clashk.ing/__local-game-assets
# CLASHKING_LOCAL_ASSETS_ROOT=/absolute/path/to/clashking_assets/assets
# CLASHKING_LOCAL_PORTAL_ICON=/absolute/path/to/extracted/portal_pendant.webp
