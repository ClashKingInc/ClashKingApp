#!/usr/bin/env bash
set -euo pipefail

readonly SESSION="clashking-app-dev"
readonly PORT="7357"
readonly PUBLIC_URL="https://dev-app.clashk.ing"
readonly SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
readonly SCRIPT_REPO_ROOT="$(git -C "$(dirname "$SCRIPT_PATH")/.." rev-parse --show-toplevel)"
readonly COMMON_GIT_DIR="$(git -C "$SCRIPT_REPO_ROOT" rev-parse --path-format=absolute --git-common-dir)"
readonly STATE_DIR="$COMMON_GIT_DIR/dev-app"
readonly STATE_FILE="$STATE_DIR/worktree"
readonly LOCK_FILE="$STATE_DIR/command.lock"

usage() {
  cat <<'EOF'
Usage: tooling/dev-app <command> [worktree]

Commands:
  start [worktree]   Start the current or specified worktree; refuse to replace another active worktree
  use <worktree>     Stop the active worktree and switch the shared dev URL to this worktree
  reload             Request an Expo reload in the active session
  restart            Fully restart the selected worktree
  stop               Stop the shared development process
  status             Show the active worktree, branch, tmux session, and URL
  logs               Print recent Expo output
  attach             Attach to the shared tmux session
EOF
}

fail() {
  printf 'dev-app: %s\n' "$*" >&2
  exit 1
}

session_exists() {
  tmux has-session -t "$SESSION" 2>/dev/null
}

session_worktree() {
  local value
  value="$(tmux show-environment -t "$SESSION" DEV_APP_WORKTREE 2>/dev/null || true)"
  [[ "$value" == DEV_APP_WORKTREE=* ]] && printf '%s\n' "${value#DEV_APP_WORKTREE=}"
}

resolve_worktree() {
  local requested="${1:-$PWD}"
  local root common

  root="$(git -C "$requested" rev-parse --show-toplevel 2>/dev/null)" || fail "not a Git worktree: $requested"
  root="$(realpath "$root")"
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)"

  [[ "$common" == "$COMMON_GIT_DIR" ]] || fail "worktree does not belong to ClashKing App: $root"
  [[ -f "$root/expo/package.json" ]] || fail "Expo project not found in worktree: $root"
  printf '%s\n' "$root"
}

ensure_port_free() {
  if port_in_use; then
    fail "port $PORT is already in use outside the $SESSION session"
  fi
}

port_in_use() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | grep -q .
  elif command -v ss >/dev/null 2>&1; then
    ss -H -ltn "sport = :$PORT" 2>/dev/null | grep -q .
  else
    fail "neither lsof nor ss is available to inspect port $PORT"
  fi
}

wait_for_port_release() {
  local attempt
  for attempt in {1..40}; do
    if ! port_in_use; then
      return
    fi
    sleep 0.25
  done
  fail "port $PORT did not release after stopping $SESSION"
}

remember_worktree() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$STATE_FILE"
}

start_worktree() {
  local worktree="$1"
  local active command

  if session_exists; then
    active="$(session_worktree)"
    if [[ "$active" == "$worktree" ]]; then
      printf 'Already running %s at %s\n' "$worktree" "$PUBLIC_URL"
      return
    fi
    fail "another worktree is active: ${active:-unknown}; use 'tooling/dev-app use $worktree' to switch"
  fi

  ensure_port_free
  command=(
    env
    BROWSER=none
    EXPO_PUBLIC_CK_API_ENV=production
    EXPO_PUBLIC_CK_API_BASE_URL=https://api.clashk.ing
    EXPO_PUBLIC_CK_API_V2_BASE_URL=https://api.clashk.ing/v2
    EXPO_PUBLIC_CK_PROXY_BASE_URL=https://api.clashk.ing/proxy/v1
    EXPO_PUBLIC_CK_PUSH_API_V2_BASE_URL=https://api.clashk.ing/v2
    EXPO_PUBLIC_CK_WEB_DISCORD_REDIRECT_URI=http://localhost:7357/auth/callback
    EXPO_PUBLIC_CK_DISCORD_SIGN_IN_ENABLED=true
    npm run start -- --web --host localhost --port "$PORT"
  )

  printf -v command_line '%q ' "${command[@]}"
  tmux new-session -d -s "$SESSION" -c "$worktree/expo" "exec $command_line"
  tmux set-environment -t "$SESSION" DEV_APP_WORKTREE "$worktree"
  remember_worktree "$worktree"
  printf 'Started %s in tmux session %s\n%s\n' "$worktree" "$SESSION" "$PUBLIC_URL"
}

stop_session() {
  if session_exists; then
    tmux kill-session -t "$SESSION"
    wait_for_port_release
    printf 'Stopped tmux session %s\n' "$SESSION"
  else
    printf 'No dev app is running\n'
  fi
}

selected_worktree() {
  local active
  if session_exists; then
    active="$(session_worktree)"
    [[ -n "$active" ]] && printf '%s\n' "$active" && return
  fi
  [[ -s "$STATE_FILE" ]] || fail "no worktree has been selected; run 'tooling/dev-app start [worktree]'"
  cat "$STATE_FILE"
}

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

mkdir -p "$STATE_DIR"

if [[ "${1:-}" == attach ]]; then
  session_exists || fail "no dev app is running"
  exec tmux attach-session -t "$SESSION"
fi

if [[ "${DEV_APP_COMMAND_LOCKED:-}" != 1 ]]; then
  command -v lockf >/dev/null 2>&1 || fail "lockf is required to coordinate dev-app commands"
  exec lockf -t 0 "$LOCK_FILE" env DEV_APP_COMMAND_LOCKED=1 "$SCRIPT_PATH" "$@"
fi

case "${1:-}" in
  start)
    start_worktree "$(resolve_worktree "${2:-$PWD}")"
    ;;
  use)
    [[ -n "${2:-}" ]] || fail "use requires a worktree path"
    worktree="$(resolve_worktree "$2")"
    stop_session
    start_worktree "$worktree"
    ;;
  reload)
    session_exists || fail "no dev app is running"
    tmux send-keys -t "$SESSION" r
    printf 'Requested Expo reload for %s\n' "$(session_worktree)"
    ;;
  restart)
    worktree="$(selected_worktree)"
    stop_session
    start_worktree "$(resolve_worktree "$worktree")"
    ;;
  stop)
    stop_session
    ;;
  status)
    if session_exists; then
      worktree="$(session_worktree)"
      branch="$(git -C "$worktree" branch --show-current 2>/dev/null || true)"
      printf 'Status: running\nWorktree: %s\nBranch: %s\nSession: %s\nPort: %s\nURL: %s\n' \
        "${worktree:-unknown}" "${branch:-detached}" "$SESSION" "$PORT" "$PUBLIC_URL"
    else
      printf 'Status: stopped\nSession: %s\nPort: %s\nURL: %s\n' "$SESSION" "$PORT" "$PUBLIC_URL"
      [[ -s "$STATE_FILE" ]] && printf 'Last worktree: %s\n' "$(cat "$STATE_FILE")"
    fi
    ;;
  logs)
    session_exists || fail "no dev app is running"
    tmux capture-pane -p -S -200 -t "$SESSION"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
